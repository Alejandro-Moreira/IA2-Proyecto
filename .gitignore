# Entornos virtuales y variables de entorno
.venv/
venv/
ENV/
env/
.env

# Bytecode y cache de Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Datos crudos, intermedios y procesados (Protección LOPDP y archivos pesados)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.csv
*.tsv
*.zip

# Modelos, pesos y checkpoints
models/
*.pt
*.pth
*.h5
*.bin
checkpoint-*/

# Reportes generados (mantener estructura con .gitkeep)
reports/figuras/*
!reports/figuras/.gitkeep
reports/tablas/*
!reports/tablas/.gitkeep

# IDEs y editores
.vscode/
.idea/
*.swp
*.swo

# Archivos de sistema operativo
Thumbs.db
Desktop.ini
.DS_Store
